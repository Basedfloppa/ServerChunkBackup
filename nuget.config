<?xml version="1.0" encoding="utf-8"?>
<configuration>
  <!--
    We keep the NuGet cache inside the repository. This is convenient in sandboxes/CI,
    where the home directory may be read-only.
    On a normal machine this file can be deleted.
  -->
  <config>
    <add key="globalPackagesFolder" value=".nuget/packages" />
  </config>
  <packageSources>
    <clear />
    <add key="nuget.org" value="https://api.nuget.org/v3/index.json" protocolVersion="3" />
  </packageSources>
</configuration>
