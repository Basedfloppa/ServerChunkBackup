<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>annotations</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <LangVersion>latest</LangVersion>
    <AssemblyName>vsfullcapture-writer</AssemblyName>
    <RootNamespace>VsFullCaptureWriter</RootNamespace>
    <NoWarn>$(NoWarn);CS0618;NU1701</NoWarn>
    <VintageStory Condition="'$(VintageStory)' == ''">$(VINTAGE_STORY)</VintageStory>
  </PropertyGroup>

  <Target Name="CheckVintageStory" BeforeTargets="ResolveAssemblyReferences">
    <Error Condition="'$(VintageStory)' == ''"
           Text="VINTAGE_STORY is not set: point it at the Vintage Story installation directory (export VINTAGE_STORY=/path/to/VintageStory)." />
    <Error Condition="!Exists('$(VintageStory)/VintagestoryLib.dll')"
           Text="There is no VintagestoryLib.dll in '$(VintageStory)' — check VINTAGE_STORY." />
  </Target>

  <ItemGroup>
    <!-- The capture formats and model come in as a project reference: this tool is a
         plain application and does not need the source-substitution trick (only the mod does). -->
    <ProjectReference Include="..\..\src\VsChunkDump.Core\VsChunkDump.Core.csproj" />
    <!-- Code shared with the mod: packet mapping and world assembly. -->
    <Compile Include="..\..\src\VsFullCapture\PacketMapping.cs" Link="Shared\PacketMapping.cs" />
    <Compile Include="..\..\src\VsFullCapture\WorldBuild\WorldBuilder.cs" Link="Shared\WorldBuilder.cs" />
    <Compile Include="..\..\src\VsFullCapture\WorldBuild\ChunkBlobWriter.cs" Link="Shared\ChunkBlobWriter.cs" />
    <Compile Include="..\..\src\VsFullCapture\WorldBuild\EntitySaveData.cs" Link="Shared\EntitySaveData.cs" />
    <Compile Include="..\..\src\VsFullCapture\WorldBuild\BlockEntityRewrite.cs" Link="Shared\BlockEntityRewrite.cs" />
    <Compile Include="..\..\src\VsFullCapture\WorldBuild\GameZstdCodec.cs" Link="Shared\GameZstdCodec.cs" />
    <Compile Include="..\..\src\VsFullCapture\WorldBuild\TemplateFactory.cs" Link="Shared\TemplateFactory.cs" />
    <Compile Include="..\..\src\VsFullCapture\WorldBuild\StandaloneChunkDataPool.cs" Link="Shared\StandaloneChunkDataPool.cs" />
  </ItemGroup>

  <ItemGroup>
    <Reference Include="VintagestoryLib">
      <HintPath>$(VintageStory)/VintagestoryLib.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="VintagestoryAPI">
      <HintPath>$(VintageStory)/VintagestoryAPI.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="protobuf-net">
      <HintPath>$(VintageStory)/Lib/protobuf-net.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="Microsoft.Data.Sqlite">
      <HintPath>$(VintageStory)/Lib/Microsoft.Data.Sqlite.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="SQLitePCLRaw.core">
      <HintPath>$(VintageStory)/Lib/SQLitePCLRaw.core.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="SQLitePCLRaw.batteries_v2">
      <HintPath>$(VintageStory)/Lib/SQLitePCLRaw.batteries_v2.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="SQLitePCLRaw.provider.e_sqlite3">
      <HintPath>$(VintageStory)/Lib/SQLitePCLRaw.provider.e_sqlite3.dll</HintPath>
      <Private>false</Private>
    </Reference>
  </ItemGroup>

</Project>
